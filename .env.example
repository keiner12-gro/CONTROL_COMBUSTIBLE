# ============================================================================
# .env.example — copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube a git. En Vercel estas mismas variables se
# cargan en: Project > Settings > Environment Variables.
# Guías completas: docs/GUIA-SUPABASE.md y docs/GUIA-AIRTABLE.md
# ============================================================================

# --- ¿Qué base de datos usa la app? -----------------------------------------
# postgres (por defecto, no hace falta escribirlo) o airtable.
# DB_PROVIDER=postgres

# ============================================================================
# OPCIÓN A: Postgres/Supabase (deja esto si DB_PROVIDER=postgres o está vacío)
# ============================================================================

# --- Base de datos (Supabase) — OBLIGATORIA con DB_PROVIDER=postgres --------
# Supabase > botón "Connect" > "Transaction pooler" (puerto 6543). Para
# scripts locales (npm run db:migrar) también sirve la "Session pooler" (5432).
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Archivos adjuntos (Supabase Storage) — OBLIGATORIAS en producción ------
# Project Settings > API: "Project URL" y la clave "service_role" (secreta:
# solo en el servidor, jamás en el navegador ni en git).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=soportes

# ============================================================================
# OPCIÓN B: Airtable (deja esto y pon DB_PROVIDER=airtable arriba)
# ============================================================================

# Se usa la MISMA cuenta/base para los datos Y para los archivos adjuntos.
# airtable.com/create/tokens: alcances data.records:read, data.records:write,
# schema.bases:read, schema.bases:write, con acceso a esa base.
# AIRTABLE_API_KEY=
# Base ID de la URL de tu base en Airtable (empieza por "app").
# AIRTABLE_BASE_ID=

# --- Avisos de "falta cerrar la jornada" -----------------------------------
# Secreto largo (mín. 16 caracteres) que protege la tarea programada.
# Vercel lo envía solo a sus cron jobs. Genera uno con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# Claves de notificaciones push (gratis):  npm run generar-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --- Reglas de la operación -------------------------------------------------
ZONA_HORARIA=America/Bogota
# A partir de esta hora, una jornada abierta de HOY se considera "tarde para cerrar"
HORA_LIMITE_CIERRE=18:00
MIN_MUESTRAS_PROMEDIO=5
FACTOR_ALERTA_PROMEDIO=1.25
# Cuántos días atrás puede registrar un supervisor/administrador (fechas retroactivas)
DIAS_ATRAS_PERMITIDOS=3
DIAS_ATRAS_ADMIN=30

# --- Opcionales -------------------------------------------------------------
PUERTO=3000
# Texto del certificado raíz de Supabase para verificar la conexión SSL (recomendado en producción)
# DATABASE_SSL_CA=
# DB_POOL_MAX=5

# --- Solo para migrar datos desde la base antigua (npm run migrar-datos) ----
# ORIGEN_DB_HOST=
# ORIGEN_DB_USER=
# ORIGEN_DB_PASSWORD=
# ORIGEN_DB_NAME=
# ORIGEN_DB_PORT=4000

# --- Solo para crear el primer administrador (npm run db:sembrar) -----------
# ADMIN_USUARIO=admin
# ADMIN_CONTRASENA=
