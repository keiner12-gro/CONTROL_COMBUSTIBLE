{
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/html/:pagina.html",
      "destination": "/:pagina",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(css|js|vendor|icons|assets)/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ],
  "crons": [
    { "path": "/api/tareas/recordatorio-cierre?momento=manana", "schedule": "0 12 * * *" },
    { "path": "/api/tareas/recordatorio-cierre?momento=tarde", "schedule": "0 23 * * *" }
  ]
}
